<p style="color: green"><%= notice %></p>

<% content_for :title, "Cars" %>

<h1>Cars</h1>

<%= image_tag("car.jpg", height: "150") %>

<div id="cars">
  <% @cars.each do |car| %>
    <%= render car %>
    <p>
      <%= link_to "Show this car", car %>
    </p>
  <% end %>
  <%# this is to display all cars <%= render @cars %>
</div>

<%= link_to "New car", new_car_path %>

<%= form_with(url: "/search", method: "get", data: { turbo: false} ) do %>
  <%= label_tag(:query, "Search for:") %>
  <%= text_field_tag(:query) %>
  <%= submit_tag("Search") %>
<% end %>

<h1>Search results for: <%= @query %></h1>